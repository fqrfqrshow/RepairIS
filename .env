# Конфигурация приложения RepairIS

# Путь к папке с JSON-файлами данных
DATA_PATH=./data

# Путь к папке с резервными копиями
BACKUP_PATH=./backup/local

# Включение логирования (true / false)
ENABLE_LOGGING=true

# Настройки подключения к базе данных (для будущего перехода на PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=repairis_db
DB_USER=postgres
DB_PASSWORD=postgres
