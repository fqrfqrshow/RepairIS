meta {
  name: Get request by id
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/requests/{{requestId}}
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("id matches", () => expect(res.body.id).to.equal(Number(bru.getEnvVar("requestId"))));
}
