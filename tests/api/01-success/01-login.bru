meta {
  name: Login manager
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}
body:json {
  { "login": "manager", "password": "manager123" }
}
script:post-response {
  bru.setEnvVar("token", res.body.token);
}
tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("token present", () => expect(res.body.token).to.be.a("string"));
}
