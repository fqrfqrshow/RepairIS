meta {
  name: List requests with filter
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/requests?status=in_progress&page=1&limit=20
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("status 200", () => expect(res.status).to.equal(200));
  test("has items", () => expect(res.body).to.have.property("items"));
  test("has total", () => expect(res.body).to.have.property("total"));
}
